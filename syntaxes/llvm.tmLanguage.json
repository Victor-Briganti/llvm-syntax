{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "llvm-syntax",
	"patterns": [
		{
			"include": "#types"
		}
	],
	"repository": {
		"types": {
			"patterns": [
				{
					"name": "keyword.control.llvm",
					"match": "\\b(void|half|bfloat|float|double|x86_fp80|fp128|ppc_fp128|label|metadata|x86_mmx|x86_amx|type|label|opaque|token|ptr)\\b"
				},
				{
					"name": "keyword.control.llvm",
					"match": "(?<![\\w$])i\\d+(?![\\w$])"
				}
			]
		}
	},
	"scopeName": "source.llvm"
}