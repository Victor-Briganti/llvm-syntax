{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "tablegen",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#types"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#line-comments"
		},
		{
			"include": "#block-comments"
		},
		{
			"include": "#todos"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.td",
					"match": "\\b(?:def|let|in|code|dag|field|include|defm|foreach|defset|defvar|if|then|else|assert|dump)\\b"
				}
			]
		},
		"types": {
			"patterns": [
				{
					"name": "storage.type.td",
					"match": "\\b(?:class|int|string|list|bit|bits|multiclass)\\b"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.td",
					"match": "\\b(?:\\d+\\.?\\d*|0b[01]+|0x[0-9a-fA-F]+)\\b"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.td",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.td",
					"match": "\\\\[a-fA-F0-9]{2}|\\\\[rnt\\\\\"]"
				}
			]
		},
		"line-comments": {
			"name": "comment.line.double-slash.td",
			"begin": "//",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.comment.td"
				}
			},
			"end": "$",
			"patterns": [
				{
					"include": "#todos"
				}
			]
		},
		"block-comments": {
			"name": "comment.block.td",
			"begin": "/\\*",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.comment.begin.td"
				}
			},
			"end": "\\*/",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.comment.end.td"
				}
			},
			"patterns": [
				{
					"include": "#todos"
				},
				{
					"include": "#block-comments"
				}
			]
		},
		"todos": {
			"match": "\\b(TODO|FIXME)\\b",
			"name": "keyword.codetag.notation.td"
		}
	},
	"scopeName": "source.td"
}