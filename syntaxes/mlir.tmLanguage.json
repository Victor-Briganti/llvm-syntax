{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "MLIR",
	"patterns": [
		{
			"include": "#types"
		},
		{
			"include": "#builtins"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#labels"
		},
		{
			"include": "#numerics"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#comments"
		}
	],
	"repository": {
		"types": {
			"patterns": [
				{
					"name": "storage.type.mlir",
					"match": "\\b(?:index|f16|f32|f64|bf16)\\b"
				},
				{
					"name": "storage.type.mlir",
					"match": "\\b(?:i\\d+)\\b"
				},
				{
					"name": "storage.type.mlir",
					"match": "\\b(?:ui\\d+)\\b"
				},
				{
					"name": "storage.type.mlir",
					"match": "\\b(?:si\\d+)\\b"
				},
				{
					"match": "x\\s*(f16|f32|f64|bf16i\\d+|ui\\d+|si\\d+)\\b",
					"captures": {
						"1": {
							"name": "storage.type.mlir"
						}
					}
				},
				{
					"match": "\\b(memref|tensor|vector)(?=\\s*<)",
					"captures": {
						"1": {
							"name": "storage.type.mlir"
						}
					}
				},
				{
					"match": "x\\s*(vector)",
					"captures": {
						"1": {
							"name": "storage.type.mlir"
						}
					}
				}
			]
		},
		"builtins": {
			"patterns": [
				{
					"name": "support.function.mlir",
					"match": "\\b(?:alloc|alloca|addf|addi|and|call|call_indirect|cmpf|cmpi|constant|dealloc|divf|dma_start|dma_wait|dim|exp|getTensor|index_cast|loc|load|log|memref_cast|memref_shape_cast|mulf|muli|negf|powf|prefetch|rsqrt|sitofp|splat|store|select|sqrt|subf|subi|subview|tanh|view)\\b"
				},
				{
					"match": "(?<![%!#@])\\b([a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z0-9_.]+))+\\b",
					"name": "support.function.mlir"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.mlir",
					"match": "\\b(?:affine_map|affine_set|dense|else|func|module|return|step|to)\\b"
				}
			]
		},
		"variables": {
			"patterns": [
				{
					"name": "variable.other.global.mlir",
					"match": "@(?:\\d+|[-a-zA-Z$._][-a-zA-Z$._0-9]*)\\b"
				},
				{
					"name": "variable.other.local.mlir",
					"match": "%(?:\\d+|[-a-zA-Z$._][-a-zA-Z$._0-9]*)\\b"
				},
				{
					"name": "storage.type.mlir",
					"match": "(?<=!)[a-zA-Z]+(?=\\s*\\()"
				},
				{
					"name": "entity.name.tag.mlir",
					"match": "!(?:\\d+|[-a-zA-Z$._][-a-zA-Z$._0-9]*)(?![a-zA-Z$._0-9])"
				}
			]
		},
		"labels": {
			"patterns": [
				{
					"name": "entity.name.tag.mlir",
					"match": "[-a-zA-Z$._][-a-zA-Z$._0-9]*(?=:)"
				}
			]
		},
		"numerics": {
			"patterns": [
				{
					"match": "\\b0x[0-9a-fA-F]+\\b",
					"name": "constant.numeric.hex.mlir"
				},
				{
					"match": "-?\\b\\d+\\.\\d*(?:[eE][+-]?\\d+)?\\b",
					"name": "constant.numeric.float.mlir"
				},
				{
					"match": "((?<=x-?)|\\b)\\d+((?=x)|\\b)",
					"name": "constant.numeric.integer.mlir"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.mlir",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.mlir",
					"match": "\\\\[a-fA-F0-9]{2}|\\\\[rnt\\\\\"]"
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"match": "(//)(\\s*(?:PR\\d+|REQUIRES|RUN|ALLOW_RETRIES|CHECK-(?:EMPTY|NEXT|NOT|DAG|SAME|LABEL|COUNT-\\d+)|CHECK|XFAIL))(.*)",
					"captures": {
						"1": {
							"name": "comment.line.double-slash.mlir"
						},
						"2": {
							"name": "keyword.other.directive.mlir"
						},
						"3": {
							"name": "comment.line.double-slash.mlir"
						}
					}
				},
				{
					"name": "comment.mlir",
					"match": "//.*$"
				}
			]
		}
	},
	"scopeName": "source.mlir"
}