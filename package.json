{
  "name": "llvm-syntax",
  "displayName": "LLVM Syntax",
  "description": "LLVM Tablegen, MLIR and IR syntax highlight extension",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ll",
        "aliases": [
          "ll",
          "llvm-ir"
        ],
        "extensions": [
          ".ll"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "td",
        "aliases": [
          "td",
          "tablegen"
        ],
        "extensions": [
          ".td"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ll",
        "scopeName": "source.ll",
        "path": "./syntaxes/ll.tmLanguage.json"
      },
      {
        "language": "td",
        "scopeName": "source.td",
        "path": "./syntaxes/td.tmLanguage.json"
      }
    ]
  }
}